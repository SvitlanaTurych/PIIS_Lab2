# Single-stage варіант (для порівняння розмірів): навчання й інференс в одному образі.
FROM python:3.10-slim
ARG EPOCHS=10
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libsndfile1 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-train.txt .
RUN pip install --no-cache-dir -r requirements-train.txt
COPY src/ ./src/
RUN python -m src.train --classes yes no up down --epochs ${EPOCHS} --seed 42 \
        --data-root /app/data --out /app/artifacts
ENV MODEL_PATH=/app/artifacts/model.pt PYTHONUNBUFFERED=1
RUN useradd --create-home appuser && chown -R appuser /app
USER appuser
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"
CMD ["uvicorn", "src.api:app", "--host", "0.0.0.0", "--port", "8000"]
